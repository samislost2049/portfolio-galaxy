# Copy this file to .env and fill in the values.
# For local testing you can leave DATABASE_URL empty — it will use SQLite.

# Connection string for a free Neon Postgres database (production only).
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Used to sign admin login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# The admin login you will use at yourdomain.onrender.com/admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Where the portfolio is hosted (for CORS). * allows any origin while testing.
CORS_ORIGIN=*

# Port (Render sets this automatically)
PORT=3000